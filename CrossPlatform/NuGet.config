<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="artifacts/nuget" />
    <add key="httpCachePath" value="artifacts/nuget-http-cache" />
    <add key="pluginsCachePath" value="artifacts/nuget-plugin-cache" />
    <add key="signatureValidationMode" value="require" />
    <add key="updatePackageLastAccessTime" value="false" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <trustedSigners>
    <author name="microsoft">
      <certificate fingerprint="566A31882BE208BE4422F7CFD66ED09F5D4524A5994F50CCC8B05EC0528C1353" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </author>
  </trustedSigners>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
